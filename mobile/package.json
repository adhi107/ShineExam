{
  "name": "shine-exam-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "build:generic:debug": "cd android && .\\gradlew assembleGenericDebug && cd ..",
    "build:generic:release": "cd android && .\\gradlew assembleGenericRelease && cd ..",
    "bundle:generic:release": "cd android && .\\gradlew bundleGenericRelease && cd ..",
    "build:abc:release": "cd android && .\\gradlew assembleAbcRelease && cd ..",
    "bundle:abc:release": "cd android && .\\gradlew bundleAbcRelease && cd ..",
    "build:xyz:release": "cd android && .\\gradlew assembleXyzRelease && cd ..",
    "bundle:xyz:release": "cd android && .\\gradlew bundleXyzRelease && cd .."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
