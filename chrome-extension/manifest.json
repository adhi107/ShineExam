{
  "manifest_version": 3,
  "name": "Victory Study Circle",
  "version": "2.0.0",
  "description": "Victory Study Circle — Premier Examination, Test Series & Learning Portal",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
